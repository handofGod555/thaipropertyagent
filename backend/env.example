# Server Configuration
PORT=3001

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# ElevenLabs API Configuration
# Get your API key from: https://elevenlabs.io
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Voice ID for Thai TTS (find voices at: https://elevenlabs.io/voice-library)
# Default: Charlotte (XB0fDUnXU5powFXDhCwa) - excellent multilingual/Thai support
ELEVENLABS_VOICE_ID=XB0fDUnXU5powFXDhCwa

# Smithery AI Configuration
# Get your API key from: https://smithery.ai
SMITHERY_API_KEY=your_smithery_api_key_here
SMITHERY_API_URL=https://api.smithery.ai/v1

